PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/leasify
JWT_SECRET=your_super_secret_jwt_access_token_secret_key_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_secret_key_54321
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary (Optional - system falls back to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP Settings (Recommended for real email delivery)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Alternative / Legacy Mailtrap Settings
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@leasify.com

# Razorpay Payments (Optional - works in mock mode if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
